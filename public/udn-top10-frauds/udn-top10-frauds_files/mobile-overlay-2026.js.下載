(function () {
  let isStyleAppended = false;
  let isAdBuilt = false;
  let messageCount = 0;
  let style = document.createElement('style');
  style.innerHTML = `
        .ads-Mobile_cover-1x1 {
          left: 50%;
          opacity: 0;
          position: fixed !important;
          top: 50%;
          transform: translate(-50%, -50%);
          transition: all .3s;
          visibility: hidden;
          width: 320px;
          z-index: 35;
          max-height: 100vh;
          max-height: 100dvh;
        }

        @media only screen  and (orientation: landscape) {
          .ads-Mobile_cover-1x1 {
            top: 0;
            transform: translate(-50%, 0);
          }
        }

        .ads-Mobile_cover-1x1 img {
          width: 100%;

        }

        .ads-Mobile_cover-1x1.mo2026-is-full {
          width: 100%;
        }

        .ads-Mobile_cover-1x1 .mo2026-close-btn {
          position: absolute;
          top: 10px;
          right: 10px;
          width: 40px;
          height: 40px;
          border: 0;
          background: transparent;
          cursor: pointer;
          transition: opacity .3s linear, visibility .3s linear;
          opacity: 0;
          visibility: hidden;

        }

        .ads-Mobile_cover-1x1 .mo2026-close-btn i {
          display: inline-block;
          background: black;
          box-shadow: 1px 1px 5px 0 rgba(0, 0, 0, 0.75);
          border-radius: 50%;
          border: 2px solid white;
          width: 34px;
          height: 34px;
          position: relative;
          top: 0;
          left: 2px;
          pointer-events: none;
        }

        .ads-Mobile_cover-1x1 .mo2026-close-btn i::before,
        .ads-Mobile_cover-1x1 .mo2026-close-btn i::after {
          content: '';
          position: absolute;
          width: 65%;
          top: 50%;
          left: 5px;
          background: white;
          height: 2px;
          margin-top: -1px;
        }

        .ads-Mobile_cover-1x1 .mo2026-close-btn i::before {
          transform: rotate(45deg);
        }

        .ads-Mobile_cover-1x1 .mo2026-close-btn i::after {
          transform: rotate(-45deg);
        } 

        .ads-Mobile_cover-1x1 .mo2026-video-container {
          position: relative;
        }

        .ads-Mobile_cover-1x1 a {
          display: block;
          height: 100%;
        }

        .ads-Mobile_cover-1x1 .mo2026-replay-btn,
        .ads-Mobile_cover-1x1 .mo2026-play-btn,
        .ads-Mobile_cover-1x1 .mo2026-mute-btn {
          position: absolute;
          width: 40px;
          height: 40px;
          border: 0;
          background: transparent;
          color: white;
          cursor: pointer;
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10;
        }

        .ads-Mobile_cover-1x1 .mo2026-replay-btn svg,
        .ads-Mobile_cover-1x1 .mo2026-play-btn svg,
        .ads-Mobile_cover-1x1 .mo2026-mute-btn svg {
          filter: drop-shadow(1px 1px 1px rgba(0, 0, 0, 0.6));
          width: 24px;
          height: 24px;
        }

        .ads-Mobile_cover-1x1 .mo2026-replay-btn {
          top: 10px;
          left: 10px;
          display: none;
        }

        .ads-Mobile_cover-1x1 .mo2026-play-btn {
          bottom: 10px;
          right: 10px;
        }

        .ads-Mobile_cover-1x1 .mo2026-mute-btn {
          bottom: 10px;
          left: 10px;
        }
      `;

  window.addEventListener('message', function (e) {
    if (
      e.data.type === 'ad-overlay-load--image' ||
      e.data.type === 'ad-overlay-load--video'
    ) {
      messageCount++;
      console.log(
        `[mo2026] 📩 message #${messageCount} received:`,
        e.data.type,
        e.data,
      );
      if (!isStyleAppended) {
        document.head.appendChild(style);
        isStyleAppended = true;
      }
      buildAdMedia(e.data);
    }
  });

  function parseRatio(ratioStr) {
    const parts = (ratioStr || '320 / 480').split('/');
    return { w: parseFloat(parts[0]), h: parseFloat(parts[1]) };
  }

  function applyRatioHeight(el, ratio) {
    if (el.offsetWidth > 0) {
      el.style.height = (el.offsetWidth * ratio.h / ratio.w) + 'px';
    }
  }

  function buildAdMedia(data) {
    if (isAdBuilt) {
      console.warn(
        `[mo2026] ⚠️ duplicate message #${messageCount} blocked — ad already built`,
      );
      return;
    }
    isAdBuilt = true;

    const overlay = document.querySelector('.udn-overlay');

    const adDiv = document.createElement('div');
    adDiv.classList.add('ads-Mobile_cover-1x1');

    const closeBtn = document.createElement('button');
    closeBtn.innerHTML = "<i class='mo2026-close'></i>";
    closeBtn.classList.add('mo2026-close-btn');

    const adAnchor = document.createElement('a');
    adAnchor.href = data.src;
    adAnchor.target = '_blank';

    let videoContainer;

    let mediaElement;
    if (data.type === 'ad-overlay-load--image') {
      mediaElement = document.createElement('img');
      mediaElement.src = data.image_url;
      adAnchor.appendChild(mediaElement);
    } else {
      videoContainer = document.createElement('div');
      videoContainer.classList.add('mo2026-video-container');
      mediaElement = document.createElement('video');
      mediaElement.src = data.video_url;
      mediaElement.muted = true;
      mediaElement.playsInline = true;
      mediaElement.loop = false;
      adDiv.style.backgroundImage = `url(${data.image_url})`;
      adDiv.style.backgroundSize = 'cover';
      adDiv.style.backgroundPosition = 'center';
      adDiv.style.backgroundRepeat = 'no-repeat';
      videoContainer.appendChild(mediaElement);
      adAnchor.appendChild(videoContainer);
    }

    // Safari fix: compute container height in JS instead of CSS aspect-ratio
    // (Safari has a rounding bug with aspect-ratio that causes visible gaps)
    const containerRatioStr = data.aspect_ratio === '16 / 9' ? '320 / 480' : (data.aspect_ratio || '320 / 480');
    const containerRatio = parseRatio(containerRatioStr);

    mediaElement.style.aspectRatio = data.aspect_ratio || '320 / 480';
    mediaElement.style.objectFit = 'cover';
    mediaElement.style.width = '100%';

    adDiv.appendChild(adAnchor);
    adDiv.appendChild(closeBtn);

    if (mediaElement.tagName === 'VIDEO') {
      const svgPlay =
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
      const svgPause =
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
      const svgReplay =
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>';
      const svgMuted =
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>';
      const svgUnmuted =
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>';

      const replayBtn = document.createElement('button');
      replayBtn.innerHTML = svgReplay;
      replayBtn.classList.add('mo2026-replay-btn');
      videoContainer.appendChild(replayBtn);

      const playBtn = document.createElement('button');
      playBtn.innerHTML = svgPlay;
      playBtn.classList.add('mo2026-play-btn');
      videoContainer.appendChild(playBtn);

      const muteBtn = document.createElement('button');
      muteBtn.innerHTML = svgMuted;
      muteBtn.classList.add('mo2026-mute-btn');
      videoContainer.appendChild(muteBtn);

      mediaElement.addEventListener('play', () => {
        playBtn.innerHTML = svgPause;
        replayBtn.style.display = 'none';
        playBtn.style.display = 'flex';
      });

      mediaElement.addEventListener('pause', () => {
        if (mediaElement.currentTime < mediaElement.duration) {
          playBtn.innerHTML = svgPlay;
        }
      });

      mediaElement.addEventListener('ended', () => {
        replayBtn.style.display = 'flex';
        playBtn.style.display = 'none';
        muteBtn.style.display = 'none';
      });

      mediaElement.addEventListener('volumechange', () => {
        if (mediaElement.muted) {
          muteBtn.innerHTML = svgMuted;
        } else {
          muteBtn.innerHTML = svgUnmuted;
        }
      });

      playBtn.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();
        if (mediaElement.paused || mediaElement.ended) {
          mediaElement.play().catch(console.warn);
        } else {
          mediaElement.pause();
        }
      });

      muteBtn.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();
        mediaElement.muted = !mediaElement.muted;
      });

      replayBtn.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();
        replayBtn.style.display = 'none';
        mediaElement.currentTime = 0;
        muteBtn.style.display = 'flex';
        mediaElement.play().catch(console.warn);
      });
    }

    document.body.appendChild(adDiv);

    // Apply full-width BEFORE computing height so offsetWidth is correct
    if (data.is_full) {
      adDiv.classList.add('mo2026-is-full');
    }

    // Safari aspect-ratio fix: compute container height in JS for video mode only
    // This avoids Safari's floating-point rounding bug with CSS aspect-ratio
    function updateContainerHeight() {
      if (data.type !== 'ad-overlay-load--image') {
        applyRatioHeight(adDiv, containerRatio);
      }
    }
    updateContainerHeight();
    window.addEventListener('resize', updateContainerHeight);

    function closeAds() {
      adDiv.style.visibility = 'hidden';
      adDiv.style.opacity = '0';
      overlay.style.visibility = 'hidden';
      overlay.style.opacity = '0';
      setTimeout(() => {
        adDiv.remove();
        window.removeEventListener('resize', updateContainerHeight);
      }, 300);
    }

    closeBtn.addEventListener('click', closeAds);

    if (data.overlay_close) {
      overlay.style.cursor = 'pointer';
      overlay.addEventListener('click', closeAds);
    }



    let isAdShown = false;

    function showAd() {
      if (isAdShown) return;
      isAdShown = true;

      overlay.style.visibility = 'visible';
      overlay.style.opacity = '1';
      overlay.style.zIndex = '36';

      const visibleTimeout = data.visible_timeout
        ? parseInt(data.visible_timeout, 10)
        : 0;
      setTimeout(() => {
        adDiv.style.zIndex = '1618033991';
        adDiv.style.visibility = 'visible';
        adDiv.style.opacity = '1';
        if (mediaElement.tagName === 'VIDEO') {
          mediaElement.play().catch(e => console.warn('Autoplay blocked:', e));
        }

        const closeBtnTime = data.close_btn_time || data.close_btn_timeout || 0;
        setTimeout(
          () => {
            closeBtn.style.visibility = 'visible';
            closeBtn.style.opacity = '1';
          },
          parseInt(closeBtnTime, 10),
        );
      }, visibleTimeout);
    }

    if (data.is_scroll) {
      function onScroll() {
        if (window.scrollY >= 100) {
          showAd();
          window.removeEventListener('scroll', onScroll);
        }
      }

      if (window.scrollY >= 100) {
        showAd();
      } else {
        window.addEventListener('scroll', onScroll);
      }
    } else {
      showAd();
    }
  }
})();
